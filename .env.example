# ----- PostgreSQL (docker-compose + backend) -----
POSTGRES_DB=recruit_inbox
POSTGRES_USER=recruit
POSTGRES_PASSWORD=recruit_local_pw
POSTGRES_PORT=5432

# ----- Redis (docker-compose + backend) -----
REDIS_PORT=6379

# ----- Backend (Spring Boot) -----
# JDBC URL is assembled from the values above by application.yml, override if needed.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recruit_inbox
SPRING_DATASOURCE_USERNAME=recruit
SPRING_DATASOURCE_PASSWORD=recruit_local_pw
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SERVER_PORT=8080

# CORS origin for the Next.js dev server
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Frontend (Next.js) -----
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Stub adapters (Step 1: no real providers wired) -----
# Placeholders only; real keys are added when provider adapters replace the stubs.
OPENAI_API_KEY=
S3_BUCKET=
S3_REGION=
EMAIL_PROVIDER_API_KEY=
