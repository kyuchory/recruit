# ============================================================================
# Copy to .env for docker-compose; the backend reads most of these directly too.
# NEVER commit real secrets.
# ============================================================================

# ----- PostgreSQL -----
POSTGRES_DB=recruit_inbox
POSTGRES_USER=recruit
POSTGRES_PASSWORD=recruit_local_pw
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PORT=6379

# ----- Backend: datasource / redis / server -----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recruit_inbox
SPRING_DATASOURCE_USERNAME=recruit
SPRING_DATASOURCE_PASSWORD=recruit_local_pw
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Kill switches (AI / parser / notification outages must not block CRUD) -----
PARSER_ENABLED=true
PARSER_ALLOW_PRIVATE_HOSTS=false
AI_ENABLED=false
NOTIFICATIONS_ENABLED=true

# ----- AI adapter (no calls unless AI_ENABLED=true AND a key is set) -----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o-mini

# ----- Object storage (default: local filesystem) -----
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
STORAGE_LOCAL_DIR=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# ----- Google OAuth2 -----
# Production must set SPRING_PROFILES_ACTIVE=prod and provide both credentials.
# Without the prod profile, local development keeps using the seeded dev user.
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_POST_LOGIN_URL=http://localhost:3000/app
FRONTEND_LOGIN_URL=http://localhost:3000/login

# ----- Frontend -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
